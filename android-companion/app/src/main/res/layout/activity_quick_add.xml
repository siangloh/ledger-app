<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:titleTextColor="@color/text_primary"
        app:title="离线快捷记账" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="20dp">

            <!-- Type Selector -->
            <RadioGroup
                android:id="@+id/typeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radioExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="支出"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="收入"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </RadioGroup>

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记账金额 (MYR)"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/amountEditText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="16dp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账目分类"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记账日期"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/dateEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:focusable="false"
                android:clickable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input_rounded"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="16dp" />

            <!-- Note / Merchant -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="商户与备注"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/noteEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="例如：午餐、超市购物"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input_rounded"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="16dp" />

            <!-- Custom Tags -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义标签"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/tagEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="可选，如：出差 报销"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input_rounded"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="24dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/primary"
                android:text="保存账目"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- Link to Full Features Ledger -->
            <Button
                android:id="@+id/btnGoToFullLedger"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:text="✨ 需要记储蓄、账户扣减或转账？\n前往全功能记账大厅"
                android:textColor="@color/primary"
                android:textSize="13sp"
                app:strokeColor="@color/primary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
