<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/navy_primary"
        app:titleTextColor="@color/white"
        app:title="离线快速记账 (Quick Add)" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="20dp"
            android:elevation="2dp">

            <!-- Type Selector -->
            <RadioGroup
                android:id="@+id/typeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radioExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="支出 (Expense)"
                    android:checked="true"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="收入 (Income)"
                    android:textSize="15sp" />
            </RadioGroup>

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="金额 (RM)"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/amountEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="16dp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分类 (Category)"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F5F5F5"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日期 (Date)"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/dateEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:textSize="15sp"
                android:textColor="@color/navy_primary"
                android:layout_marginBottom="16dp" />

            <!-- Note / Merchant -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="商户 / 备注 (Merchant / Note)"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/noteEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="如：FamilyMart 午餐"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:textSize="15sp"
                android:textColor="@color/navy_primary"
                android:layout_marginBottom="24dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/navy_primary"
                android:text="💾 保存记录 (离线优先)"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
