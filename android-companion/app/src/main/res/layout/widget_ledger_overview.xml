<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- 顶部状态栏：图标、标题、月份与快捷操作 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layout_widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Icon" />

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_title"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="· 11月"
                android:textColor="#0F766E"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_widget_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="🔄"
                android:textSize="13sp"
                android:background="@drawable/bg_widget_pill"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_widget_quick_add"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/widget_quick_add"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_widget_button" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 中部主指标：净结余与现金流安全预估 -->
    <LinearLayout
        android:id="@+id/layout_hero_balance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp">

        <!-- 当月净结余 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_net_balance"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_net_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+RM 0.00"
                android:textColor="#0F766E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 预估安全现金流 (扣除待付后) -->
        <LinearLayout
            android:id="@+id/layout_widget_cashflow_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:background="@drawable/bg_widget_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_safe_cashflow"
                android:textColor="#64748B"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_widget_projected_cashflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+RM 0.00"
                android:textColor="#0F766E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 动态微图表区域 (支持现金流走势图 / 7日支出柱状图 / 简洁隐藏) -->
    <ImageView
        android:id="@+id/iv_widget_chart"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="4dp"
        android:scaleType="fitXY"
        android:contentDescription="Chart" />

    <!-- 底部双指标行：今日支出 & 待付账单 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 今日支出 -->
        <LinearLayout
            android:id="@+id/layout_widget_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_widget_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_expense"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_today_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RM 0.00"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 待付账单 -->
        <LinearLayout
            android:id="@+id/layout_widget_bills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_widget_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_pending_bills"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_pending_bills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 笔待付"
                android:textColor="#B45309"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

